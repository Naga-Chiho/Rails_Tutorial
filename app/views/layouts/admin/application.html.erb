<!DOCTYPE html>
<html>
  <head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# website: http://ogp.me/ns/website#">
    <title><%= yield :title %> | 管理 |Railsチュートリアル</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= yield :head %>
  </head>

  <body class="w-full flex flex-row ">
    <% if current_user %>
    <div class="w-9xl flex flex-col justify-between p-lg">
    <div>
      <div class="w-full flex flex-col items-center pt-xl py-3xl">
        <%= image_tag "logo.png" alt="ロゴ" class="w-7xl" %>
        <p class="pt-xs text-center justify-start text-xs font-bold font-japanese leading-xs tracking-tight">ユーザー管理画面</p>
      </div>
      <div class="flex flex-col items-start gap-xxl">
        <%= link_to admin_users_path, class: "w-8xl flex py-xs rounded-xs #{controller_name == 'users' ? 'bg-gold-100' : 'hover:bg-gold-100'}" do %>
          <%= image_tag "user.svg" alt="ユーザー" class="w-lg mx-xs" %>
          <p class="justify-start text-sm font-bold font-japanese leading-xs tracking-tight-md">ユーザー</p>
        <% end %>
        <%= link_to admin_departments_path, class: "w-8xl flex py-xs rounded-xs #{controller_name == 'departments' ? 'bg-gold-100' : 'hover:bg-gold-100'}" do %>
          <%= image_tag "department.svg" alt="部署" class="w-lg mx-xs" %>
          <p class="justify-start text-sm font-bold font-japanese leading-xs tracking-tight-md">部署</p>
        <% end %>
        <%= link_to admin_skills_path, class: "w-8xl flex py-xs rounded-xs #{controller_name == 'skills' ? 'bg-gold-100' : 'hover:bg-gold-100'}" do %>
          <%= image_tag "skill.svg" alt="スキル" class="w-lg mx-xs" %>
          <p class="justify-start text-sm font-bold font-japanese leading-xs tracking-tight-md">スキル</p>
        <% end %>
      </div>
    </div>
    <div class="w-full flex flex-col items-start">
        <p class="justify-start text-sm font-bold font-japanese leading-xs tracking-tight-md"><%= current_user.name %></p>
        <p class="self-stretch justify-start text-xs font-bold font-japanese leading-xs tracking-tight-sm text-gray-600"><%= current_user.department.name %></p>
        <p class="self-stretch justify-start text-xs font-japanese leading-xs tracking-tight-sm"><%= current_user.email %></p>
        <div class="flex items-center pt-3xl">
          <%= image_tag "door.svg" alt="ログアウト" class="w-lg mx-xs" %>
          <% if session[:user_id]%>
            <%= button_to 'ログアウト', admin_session_path(current_user.id), method: :delete , class: "justify-start text-sm font-bold font-japanese leading-xs tracking-tight-md" %>
          <% end %>
        </div>
      <% end %>
    </div>
    </div>
    <div class="w-full flex flex-col">
    <%= yield :breadcrumb %>

    <%= yield %>
    </div>
  </body>
</html>
