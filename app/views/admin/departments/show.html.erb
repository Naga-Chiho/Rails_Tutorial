<h1><%= @department.name %></h1>

  <nav>
    <ol style="list-style: none; display: flex; align-items: center;">
      <li><%= link_to "部署一覧", admin_departments_path %></li>
        <span>　>　</span>
      <li><%= link_to @department.name, [:admin, @department] %></li>
    </ol>
  </nav>

  <ul>
    <% @department.users.each do |user| %>
        <p><%= user.name %></p>
    <% end %>
  </ul>

<%= link_to "一覧に戻る", admin_departments_path %>
<%= link_to "編集する", edit_admin_department_path(@department) %>
<%= button_to "削除", [:admin, @department], method: :delete, data: {
    turbo_confirm: "本当に削除しますか？" 
  } %>