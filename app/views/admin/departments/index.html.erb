<div class="w-full h-auto font-japanese bg-gray-100">
  <% content_for(:title, "部署一覧") %>

  <% content_for :breadcrumb do %>
    <div class="w-full h-auto flex flex-col justify-between items-start items-stretch gap-ms px-lg py-lg bg-gray-100">
      <nav aria-label="Breadcrumb">
        <ol class="list-none flex items-center gap-2">
          <li>
            <%= link_to "Home", admin_users_path, class: "pr-xs text-md hover:text-gray-900 hover:underline" %>
          </li>
          <img src="/right-vector.svg" alt="矢印" class="w-md h-md pr-xs"/>
          <li class="pr-xs text-md hover:text-gray-900 hover:underline" aria-current="page">
            <%= content_for(:title) %>
          </li>
        </ol>
      </nav>
    </div>
  <% end %>

  <% content_for :head do %>
    <%= tag.meta name: "description", content: "部署一覧(管理者)のページです" %>
    <%= tag.meta name: "keywords", content: "Rails, Tutorial, Admin, departments, Departments, Skills" %>
    <%= tag.meta property: "og:title", content: "部署一覧 | Railsチュートリアル" %>
    <%= tag.meta property: "og:description", content: "部署一覧(管理者)のページです" %>
    <%= tag.meta property: "og:type", content: "article" %>
    <%= tag.meta property: "og:url", content: departments_url %>
    <%= tag.meta name: "twitter:card", content: "summary_large_image" %>
    <%= tag.meta name: "twitter:site", content: "@HongoMCC" %>
    <%= tag.meta name: "twitter:creator", content: "@HongoMCC" %>
  <% end %>

  <div id="departments">
    <div class="w-full flex justify-between items-center self-stretch px-lg">
      <h1 class="text-xl font-bold leading-xs tracking-tight-xxl">部署一覧</h1>
      <%= link_to "新規作成", new_admin_department_path , class: "flex align-center py-md px-lg gap-3xs border rounded-sm border-gray-400 bg-white"%>
    </div>
  </div>

   <div class="flex flex-col"> 
      <span class="w-full p-lg"><%= @departments.total_count %>件中 <%= @departments.offset_value + 1 %> 〜 <%= @departments.offset_value + @departments.length %>件を表示中</span>
      <div class="p-lg mx-lg self-stretch bg-white rounded-lg shadow-md inline-flex flex-col justify-start items-start overflow-hidden">
        <table class="w-full border-t border-gray-300">
          <thead>
            <tr>
              <th class="py-md">ID</th>
              <th class="py-md">部署名</th>
              <th class="py-md">リンク</th>
            </tr>
          </thead>
            <tbody>
              <% @departments.each do |department| %>
                <tr class="border-t border-gray-300">
                  <td class="py-md text-center"><%= department.id %></td>
                  <td class="py-md text-center"><%= department.name %></td>
                  <td class="py-md text-center flex justify-center">
                    <%= link_to [:admin, department] do %>
                      <span class="w-5xl flex items-center gap-3xs py-3xs px-sm rounded-sm border text-gray-700 hover:text-white bg-white hover:bg-gray-700 ">詳細
                        <img src="/right-vector.svg" alt="矢印" class="w-sm h-sm"/>
                      </span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
        </table>
      </div>
    </div>
    <div class="p-xxs">
      <%= paginate @departments, window: 1 %>
    </div>
  </div>
</div>




   


 

