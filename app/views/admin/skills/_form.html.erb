<div class="w-full min-h-screen pt-lg font-japanese bg-gray-100">
    <%= form_with model: [:admin, skill] do |form| %>
      <div class="w-form-max p-lg mx-lg self-stretch bg-white rounded-lg shadow-md overflow-hidden">
        <div class="flex flex-col">
          <%= form.label :name, "ID" , class:"py-xs" %>
          <%= form.text_field :id , class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm bg-gray-200"%>
        </div>
        <div class="flex flex-col">
          <%= form.label :name, "スキル名", class:"py-x pt-lg pb-xs" %>
          <%= form.text_field :name, class: "px-ms py-xs border border-gray-300 rounded-sm" %>
        </div>
        <div class="flex pt-xxl pb-lg gap-xl">
          <div class="w-full flex justify-center items-center overflow-hidden">
            <%= link_to "詳細に戻る", admin_skills_path ,class:"px-lg py-sm border rounded-md inline-flex justify-center items-center"%>
            <%= form.submit "保存する" , class:"px-lg py-sm border rounded-md inline-flex justify-center items-center" %>
          </div>
        </div>
      </div>
      
  
  
  <% end %>
</div>





  


  

 



