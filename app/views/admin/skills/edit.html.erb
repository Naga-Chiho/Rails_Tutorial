<div class="bg-gray-100">
   <% content_for :breadcrumb do %>
    <div class="w-full h-auto flex flex-col flex-1 justify-between items-start items-stretch gap-ms px-lg pt-lg bg-gray-100">
      <nav aria-label="Breadcrumb">
        <ol class="list-none flex items-center gap-2">
          <li>
            <%= link_to "Home", admin_skills_path, class: "text-gray-600 pr-xs text-md hover:text-gray-900 hover:underline" %>
          </li>
          <img src="/right-vector.svg" alt="矢印" class="w-md h-md pr-xs"/>
            <%= link_to "スキル一覧", admin_skills_path, class: "text-gray-600 pr-xs text-md hover:text-gray-900 hover:underline" %>
          <img src="/right-vector.svg" alt="矢印" class="w-md h-md pr-xs"/>
          <li>
            <%= link_to "スキル詳細(" + @skill.name + ")", [:admin, @skill] , class: "text-gray-600 pr-xs text-md hover:text-gray-900 hover:underline" %>
          </li>
          <img src="/right-vector.svg" alt="矢印" class="w-md h-md pr-xs"/>
          <li class="font-bold">
            <%= link_to "スキル編集(" + @skill.name + ")", [:admin, @skill] %>
          </li>
        </ol>
      </nav>
    </div>
  <% end %>
    <h1 class="w-full flex justify-between items-center self-stretch p-lg text-xl font-bold leading-xs tracking-tight-xxl">スキル編集</h1>

    <%= render "form", skill: @skill %>
    <%= link_to "Cancel", @skill %>
</div>