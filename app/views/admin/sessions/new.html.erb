<h1>管理画面 ログイン</h1>

<%= form_with url: admin_sessions_path do |form| %>
  <div>
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.submit "ログイン" %>
  </div>
<% end %>

<hr>

<div>
  <%= button_to 'GitHubでログイン', '/auth/github' %>
</div>