<div class="w-full h-auto font-japanese bg-gray-100">
  <% content_for(:title, "ユーザー一覧") %>

  <% content_for :breadcrumb do %>
    <div class="w-full h-auto flex flex-col flex-1 justify-between items-start items-stretch gap-ms px-lg pt-lg bg-gray-100">
      <nav>
        <ol class="list-none">
          <li><%= link_to "Home > " + content_for(:title), admin_users_path %></li>
        </ol>
      </nav>
    </div>
  <% end %>
   
  <div class="w-full flex justify-between items-center self-stretch p-lg">
    <h1 class="text-xl font-bold leading-xs tracking-tight-xxl">ユーザー一覧</h1>
    <%= link_to "新規作成", new_admin_user_path , class: "flex align-center py-md px-lg gap-3xs border rounded-sm border-gray-400 bg-white"%>
  </div>
  
  <% content_for :head do %>
    <%= tag.meta name: "description", content: "ユーザー一覧(管理者)のページです" %>
    <%= tag.meta name: "keywords", content: "Rails, Tutorial, Admin, Users, Departments, Skills" %>
    <%= tag.meta property: "og:title", content: "ユーザー一覧 | Railsチュートリアル" %>
    <%= tag.meta property: "og:description", content: "ユーザー一覧(管理者)のページです" %>
    <%= tag.meta property: "og:type", content: "article" %>
    <%= tag.meta property: "og:url", content: users_url %>
    <%= tag.meta name: "twitter:card", content: "summary_large_image" %>
    <%= tag.meta name: "twitter:site", content: "@HongoMCC" %>
    <%= tag.meta name: "twitter:creator", content: "@HongoMCC" %>
  <% end %>

  <div class="flex flex-col items-start p-md gap-md items-stretch bg-white rounded-md shadow-md mx-lg">
    <h1 class="text-lg font-bold font-weight-regular leading-xs tracking-xl">検索フォーム</h1>
    <%= form_with url: admin_users_path, method: :get do |form| %>
      <div class="w-full flex items-center pb-md">
        <div class="flex flex-col">
          <div class="flex items-center items-stretch gap-xs">
            <%= form.label :name, "名前:" , class: "font-japanese text-sm font-bold leading-xs tracking-4xl"%>
          </div>
          <div class="flex min-h-3xl items-center gap-xs flex-1 py-xs px-md bg-gray-100 rounded-md">
            <%= form.search_field :name, value: @param_name , placeholder: "テキスト" ,class: "self-stretch justify-center text-sm font-normal font-japanese leading-sm tracking-md" %>
          </div>
        </div>
        <div class="flex flex-col pl-md">
          <div class="flex items-center items-stretch gap-xs">
            <%= form.label :prefecture, "都道府県:", class: "font-japanese text-sm font-bold leading-xs tracking-4xl"%>
          </div>
          <div class="flex min-h-3xl items-center gap-xs flex-1 py-xs pr-sm pl-md rounded-md border border-gray-300">
            <%= form.select :prefecture, @user_prefectures, { include_blank: "選択してください", selected: @param_prefecture  }, class: "self-stretch justify-center text-md font-normal font-japanese leading-sm tracking-md text-gray-500" %>
          </div>
        </div>
      </div>

      <div class="flex w-full">
        <div class="flex w-1/2">
          <div class="flex flex-col">
            <div class="pb-xs">
              <%= form.label :birthday, "並び順", class:"justify-start text-sm font-bold font-japanese leading-sm tracking-tight-4xl" %>
            </div>
            <div class="flex">
              <label class="flex items-center cursor-pointer pr-xs">
                <%= form.radio_button :birthday, "asc", checked: @param_birthday == "asc", class: "border-gray-300 accent-gold-700" %>
                <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">昇順</span>
              </label>
              <label class="flex items-center text-sm cursor-pointer">
                <%= form.radio_button :birthday, "desc", checked: @param_birthday == "desc", class: "border-gray-300 accent-gold-700" %>
                <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">降順</span>
              </label>
            </div>
          </div>
          <div class="flex">
            <div class="flex flex-col pl-md">
              <div class="pb-xs">
                <%= form.label :per_page, "表示件数:", class:"justify-start text-sm font-bold font-japanese leading-sm tracking-tight-4xl" %>
              </div>
              <div class="flex">
                <label class="flex items-center cursor-pointer select-none pr-xs">
                  <%= form.radio_button :per_page, "20", checked:  @param_per_page == "20", class: "border-gray-300 accent-gold-700" %>
                  <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">20件</span>
                </label>
                <label class="flex items-center cursor-pointer select-none pr-xs">
                  <%= form.radio_button :per_page, "50", checked:  @param_per_page == "50", class: "border-gray-300 accent-gold-700" %>
                  <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">50件</span>
                </label>
                <label class="flex items-center cursor-pointer select-none pr-xs">
                  <%= form.radio_button :per_page, "100", checked:  @param_per_page == "100", class: "border-gray-300 accent-gold-700" %>
                  <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">100件</span>
                </label>
              </div>
            </div>
          </div>
        </div>
        <div class="w-1/2 pr-md size-lf-stretch inline-flex justify-end items-center gap-2 ">
          <div class="px-lg py-md rounded-sm bg-gold-900 text-white font-bold">
            <%= form.submit "検索" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>


  <% @users.each do |user| %>
    <div class="w-full h-auto flex flex-col items-start items-stretch gap-ms">
      <ul class="list-none">
        <li style="padding-bottom: 12px;">
          <h3><%= user.name %></h3>
          <%= link_to "詳細", [:admin, user] %>
        </li>
      </ul>
    </div>
  <% end %>

  <div class="p-xxs">
    <%= paginate @users %>
  </div>
</div>