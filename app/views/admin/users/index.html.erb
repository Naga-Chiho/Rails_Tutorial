<h1>Users</h1>

<div id="users">
  <%= link_to "新規作成", new_admin_user_path %>

  <%= form_with url: admin_users_path, method: :get do |form| %>
    <%= form.label :name, "名前:" %>
    <%= form.search_field :name %>

    <%= form.label :prefecture, "都道府県:" %>
    <%= form.select :prefecture, User.prefectures.keys, include_blank: "指定なし" %>
    

    <%= form.label :birthday, "誕生日:" %>
    <%= form.select :birthday, [["昇順", "asc"], ["降順", "desc"]], include_blank: "指定なし",  selected: params[:birthday] %>

    <%= form.label :per_page, "表示件数:" %>
    <%= form.select :per_page, ["10","50","100"], include_blank: "指定なし", selected: params[:per_page] || "100" %>

    <%= form.submit "探す" %>
  <% end %>

  <% @users.each do |user| %>
      <li style="padding-bottom: 12px;">
        <h3><%= user.name %></h3>
        <%= link_to "詳細", [:admin, user] %>
      </li>
  <% end %>
</div>

<%= paginate @users %>
