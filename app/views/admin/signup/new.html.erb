<div class="w-full min-h-screen flex flex-col jusyify-center items-center py-lg font-japanese bg-gray-100">
  <h1 class="w-full flex justify-between items-center self-stretch p-lg text-xl text-center font-bold leading-xs tracking-tight-xxl bg-gray-100">新規登録</h1>
  <%= form_with model: @user, url: admin_signup_index_path, local: true do |form| %>
    <div class="w-form-max p-lg mx-lg self-stretch bg-white rounded-lg shadow-md overflow-hidden">
      <div class="flex flex-col pb-lg">
        <%= form.label :name, "ID" , class:"py-xs font-bold text-gray-900" %>
        <%= form.text_field :id, disabled: true, class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm disabled:bg-gray-200" %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :name, "名前", class:"py-xs font-bold text-gray-900" %>
        <% if form.object.errors[:name].any? %>
          <%= form.text_field :name ,class: "w-1/2 px-ms py-xs border shadow-error border-red-700 rounded-sm"%>
          <p class="text-sm  text-red-700 mt-1">氏名は20文字以内としてください</p>
        <% else %>
          <%= form.text_field :name ,class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm" ,placeholder: "名前" %>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :furigana, "名前(フリガナ)", class:"py-xs font-bold  text-gray-900" %>
        <% if form.object.errors[:furigana].any? %>
          <%= form.text_field :furigana,class: "w-1/2 px-ms py-xs shadow-error border-red-700 border border-gray-300 rounded-sm" %>
          <p class="text-sm text-red-700 mt-1">フリガナは20文字以内としてください</p>
        <% else %>
          <%= form.text_field :furigana,class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm",placeholder: "フリガナ" %>
        <% end %>
      </div>

      
        <% if form.object.errors[:gender].any? %>
          <div class="flex flex-col pb-lg">
            <%= form.label :gender, "性別", class:"py-xs font-bold text-gray-900" %>
            <div class="flex pb-lg gap-sm py-xs">
              <label class="flex items-center cursor-pointer">
                <%= form.radio_button :gender, "男", checked: @param_gender == "男", class: "sr-only peer" %>
                  <div class="w-md h-md rounded-full shadow-error border border-red-700 bg-white flex items-center justify-center mr-xxs transition-all peer-checked:border-gold-600 peer-checked:bg-gold-600 after:content-[''] after:w-xxs after:h-xxs after:rounded-full after:bg-transparent peer-checked:after:bg-white"></div>
                  <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">男性</span>
              </label>
              <label class="flex items-center cursor-pointer">
                <%= form.radio_button :gender, "女", checked: @param_gender == "女", class: "sr-only peer" %>
                <div class="w-md h-md rounded-full shadow-error border border-red-700 bg-white flex items-center justify-center mr-xxs transition-all peer-checked:border-gold-600 peer-checked:bg-gold-600 after:content-[''] after:w-xxs after:h-xxs after:rounded-full after:bg-transparent peer-checked:after:bg-white"></div>
                  <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">女性</span>
              </label>
              <label class="flex items-center cursor-pointer">
                <%= form.radio_button :gender, "その他", checked: @param_gender == "その他", class: "sr-only peer" %>
                <div class="w-md h-md rounded-full shadow-error border border-red-700 bg-white flex items-center justify-center mr-xxs transition-all peer-checked:border-gold-600 peer-checked:bg-gold-600 after:content-[''] after:w-xxs after:h-xxs after:rounded-full after:bg-transparent peer-checked:after:bg-white"></div>
                  <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">未回答</span>
              </label>
              <p class="text-sm text-red-700 mt-1">性別は必須です</p>
            </div>
        <% else %>
          <div class="flex flex-col pb-lg">
            <%= form.label :gender, "性別", class:"py-xs font-bold text-gray-900" %>
            <div class="flex pb-lg gap-sm py-xs">
            <label class="flex items-center cursor-pointer">
              <%= form.radio_button :gender, "男", checked: @param_gender == "男", class: "sr-only peer" %>
                <div class="w-md h-md rounded-full border border-gray-400 bg-white flex items-center justify-center mr-xxs transition-all peer-checked:border-gold-600 peer-checked:bg-gold-600 after:content-[''] after:w-xxs after:h-xxs after:rounded-full after:bg-transparent peer-checked:after:bg-white"></div>
                <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">男性</span>
            </label>
            <label class="flex items-center cursor-pointer">
              <%= form.radio_button :gender, "女", checked: @param_gender == "女", class: "sr-only peer" %>
              <div class="w-md h-md rounded-full border border-gray-400 bg-white flex items-center justify-center mr-xxs transition-all peer-checked:border-gold-600 peer-checked:bg-gold-600 after:content-[''] after:w-xxs after:h-xxs after:rounded-full after:bg-transparent peer-checked:after:bg-white"></div>
                <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">女性</span>
            </label>
            <label class="flex items-center cursor-pointer">
              <%= form.radio_button :gender, "その他", checked: @param_gender == "その他", class: "sr-only peer" %>
              <div class="w-md h-md rounded-full border border-gray-400 bg-white flex items-center justify-center mr-xxs transition-all peer-checked:border-gold-600 peer-checked:bg-gold-600 after:content-[''] after:w-xxs after:h-xxs after:rounded-full after:bg-transparent peer-checked:after:bg-white"></div>
                <span class="justify-start text-sm font-normal font-japanese leading-xs tracking-tight">未回答</span>
            </label>
          </div>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :phone, "電話番号", class:"py-xs font-bold text-gray-900" %>
        <% if form.object.errors[:phone].any? %>
          <%= form.telephone_field :phone ,class: "w-1/2 shadow-error border-red-700 px-ms py-xs border border-gray-300 rounded-sm"%>
          <p class="text-sm text-red-700 mt-1">電話番号は必須です</p>
        <% else %>
          <%= form.telephone_field :phone ,class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm",placeholder: "電話番号を入力してください"%>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :email, "メールアドレス" , class:"py-xs font-bold text-gray-900"%>
        <% if form.object.errors[:email].any? %>
          <%= form.email_field :email,class: "w-1/2 shadow-error border-red-700 px-ms py-xs border border-gray-300 rounded-sm" %>
          <p class="text-sm text-red-700 mt-1">メールアドレスの形式が間違っています</p>
        <% else %>
          <%= form.email_field :email,class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm" ,placeholder: "メールアドレスを入力してください" %>
        <% end %>
      </div>

      <%# パスワード入力 %>
      <div class="flex flex-col pb-lg">
        <%= form.label :password, "パスワード", class: "py-xs font-bold text-gray-900" %>
        <% has_pass_error = form.object.errors[:password].any? %>
        <%= form.password_field :password, class: "w-1/2 px-ms py-xs border rounded-sm #{has_pass_error ? 'border-red-700 shadow-error' : 'border-gray-300'}", placeholder: "パスワードを入力してください" %>
        <% if has_pass_error %>
          <p class="text-sm text-red-700 mt-1"><%= form.object.errors.full_messages_for(:password).first %></p>
        <% end %>
      </div>

      <%# パスワード確認入力 %>
      <div class="flex flex-col pb-lg">
        <%= form.label :password_confirmation, "パスワード（確認用）", class: "py-xs font-bold text-gray-900" %>
        <% has_pass_conf_error = form.object.errors[:password_confirmation].any? %>
        <%= form.password_field :password_confirmation, class: "w-1/2 px-ms py-xs border rounded-sm #{has_pass_conf_error ? 'border-red-700 shadow-error' : 'border-gray-300'}",placeholder: "もう一度パスワードを入力してください" %>
        <% if has_pass_conf_error %>
          <p class="text-sm text-red-700 mt-1"><%= form.object.errors.full_messages_for(:password_confirmation).first %></p>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :postal_code, "郵便番号", class:"py-xs font-bold text-gray-900" %>
        <% if form.object.errors[:postal_code].any? %>
          <%= form.text_field :postal_code ,class: "w-1/2 shadow-error border-red-700 px-ms py-xs border border-gray-300 rounded-sm"%>
          <p class="text-sm text-red-700 mt-1">郵便番号は13桁以内としてください</p>
        <% else %>
          <%= form.text_field :postal_code ,class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm",placeholder: "郵便番号を入力してください"%>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :prefecture, "都道府県", class:"py-xs font-bold text-gray-900" %>
        <% if form.object.errors[:prefecture].any? %>
          <%= form.select :prefecture, User.prefectures.keys, { include_blank: "選択してください" }, { class: "w-1/2 shadow-error border-red-700 px-ms py-xs border border-gray-300 rounded-sm bg-white text-gray-900" } %>
          <p class="text-sm text-red-700 mt-1">都道府県は必須です</p>
        <% else %>
          <%= form.select :prefecture, User.prefectures.keys, { include_blank: "選択してください" }, { class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm bg-white text-gray-900" } %>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :city, "市区町村", class:"py-xs font-bold text-gray-900" %>
        <% if form.object.errors[:city].any? %>
          <%= form.text_field :city,class: "w-1/2 shadow-error border-red-700 px-ms py-xs border border-gray-300 rounded-sm" %>
          <p class="text-sm text-red-700 mt-1">市区町村は必須です</p>
        <% else %>
          <%= form.text_field :city,class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm",placeholder: "市区町村を入力してください" %>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :town, "町名・丁目", class:"py-xs font-bold text-gray-900" %>
        <% if form.object.errors[:town].any? %>
          <%= form.text_field :town,class: "w-1/2 shadow-error border-red-700 px-ms py-xs border border-gray-300 rounded-sm" %>
          <p class="text-sm text-red-700 mt-1">町名・丁目は必須です</p>
        <% else %>
          <%= form.text_field :town,class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm",placeholder: "町名・丁目を入力してください" %>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :street, "番地", class:"py-xs font-bold text-gray-900" %>
        <% if form.object.errors[:street].any? %>
          <%= form.text_field :street,class: "w-1/2 shadow-error border-red-700 px-ms py-xs border border-gray-300 rounded-sm" %>
          <p class="text-sm text-red-700 mt-1">番地は必須です</p>
        <% else %>
          <%= form.text_field :street,class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm",placeholder: "番地を入力してください" %>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :building, "建物名・部屋番号", class:"py-xs font-bold text-gray-900" %>
        <%= form.text_field :building,class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm",placeholder: "建物名・部屋番号を入力してください"%>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :birthday, "誕生日", class:"py-xs font-bold text-gray-900" %>
        <% if form.object.errors[:birthday].any? %>
          <%= form.date_field :birthday,value: "2000-01-01",class: "w-1/2 shadow-error border-red-700 px-ms py-xs border border-gray-300 rounded-sm"%>
          <p class="text-sm text-red-700 mt-1">誕生日は過去の日付としてください</p>
        <% else %>
          <%= form.date_field :birthday,value: "2000-01-01",class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm" ,placeholder: "フリガナ"%>
        <% end %>
      </div>

      <div class="flex flex-col pb-lg">
        <%= form.label :index_users_on_department_id, "部署", class: "py-xs font-bold text-gray-900" %>
        <%= form.collection_select :department_id, Department.all, :id, :name, { prompt: "部署を選択してください" },{ class: "w-1/2 px-ms py-xs border border-gray-300 rounded-sm bg-white text-gray-900" } %>
        <% if form.object.errors[:department_id].any? %>
          <p class="text-sm text-red-700 mt-1">部署は必須です</p>
        <% else %>
        <% end %>
      </div> 

      <div class="flex flex-col pb-lg">
        <%= form.label :skill_ids, "スキル", class: "py-xs font-bold text-gray-900" %>
        <div class="flex flex-wrap gap-xs">
          <%= form.collection_check_boxes :skill_ids, Skill.all, :id, :name do |b| %>
            <label class="flex items-center space-x-1.5 cursor-pointer whitespace-nowrap">
              <%= b.check_box class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
              <span class="text-md"><%= b.text %></span>
            </label>
          <% end %>
        </div>
      </div>
        <div class="w-full flex pt-xxl pb-lg gap-xl">
          <div class="w-full flex justify-center items-center">
            <%= link_to "戻る", admin_users_path ,class:"mx-xs px-md py-sm border rounded-md inline-flex justify-center items-center font-bold text-gray-700"%>
            <%= form.submit "保存" , class:"mx-xs px-xxl py-sm border rounded-md inline-flex justify-center items-center font-bold text-white bg-gold-900" %>
          </div>
        </div>
    </div>
  <% end %>
</div>