<%# Link to the "Next" page
  - available local variables
    url:           url to the next page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>

<% if current_page.last? %>
  <%= image_tag "elements.svg", alt: "矢印", class: "w-xxl h-xxl rotate-180" %>
<% else %>
  <span class="next w-xxl h-xxl p-ms m-xs flex justify-center items-center border rounded-xs border-gray-400 bg-white">
    <%= link_to_unless current_page.last?, image_tag('/right-vector-brown.svg', alt: "矢印", class: "w-sm h-sm"), url, rel: 'next', remote: remote %>
  </span>
<% end %>