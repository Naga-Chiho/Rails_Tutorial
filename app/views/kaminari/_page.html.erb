<%# Link showing page number
  - available local variables
    page:          a page object for "this" page
    url:           url to this page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>
<% if page.current? %>
  <span class="page<%= 'current' if page.current? %>  w-xxl h-xxl p-ms m-xs flex justify-center items-center border rounded-xs bg-gold-700 text-white">
    <%= link_to_unless page.current?, page, url, {remote: remote, rel: page.rel} %>
  </span>
<% else %>
  <span class="page<%= 'current' if page.current? %>  w-xxl h-xxl p-ms m-xs flex justify-center items-center border rounded-xs border-gray-400  border-gray-400 bg-white">
    <%= link_to_unless page.current?, page, url, {remote: remote, rel: page.rel} %>
  </span>
<% end %>