<h1>Skills</h1>

  <nav>
    <ol style="list-style: none;">
      <li><%= link_to "スキル一覧", skills_path %></li>
    </ol>
  </nav>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "スキル一覧",
        "item": "skills_url"
      }
    ]
  }
  </script>

<div id="skills">
  <% @skills.each do |skill| %>
      <li style="padding-bottom: 12px;">
        <h3><%= skill.name %></h3>
        <%= link_to "詳細", skill_path(skill) %>
      </li>
  <% end %>
</div>
