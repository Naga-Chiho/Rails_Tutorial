<% content_for(:title, "部署一覧") %>
<h1>部署一覧</h1>

<% content_for :head do %>
  <%= tag.meta name: "description", content: "部署一覧のページです" %>
  <%= tag.meta name: "keywords", content: "Rails, Tutorial, Admin, Users, Departments, Skills" %>
  <%= tag.meta name: "viewport", content: "width=device-width,initial-scale=1" %>
  <%= tag.meta name: "apple-mobile-web-app-capable", content: "yes" %>
  <%= tag.meta name: "application-name", content: "App" %>
  <%= tag.meta name: "mobile-web-app-capable", content: "yes" %>
  <%= tag.meta property: "og:title", content: "部署一覧 | Railsチュートリアル" %>
  <%= tag.meta property: "og:description", content: "部署一覧のページです" %>
  <%= tag.meta property: "og:type", content: "article" %>
  <%= tag.meta property: "og:url", content: departments_url %>
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
<% end %>

  <nav>
    <ol style="list-style: none;">
      <li><%= link_to content_for(:title), departments_path %></li>
    </ol>
  </nav>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "部署一覧",
        "item": "departments_url"
      }
    ]
  }
  </script>

  <ul>
    <% @departments.each do |department| %>
      <li style="padding-bottom: 12px;">
        <h3><%= department.name %></h3>
        <%= link_to "詳細", department_path(department) %>
      </li>
    <% end %>
  </ul>
</div>  