<h1>部署一覧</h1>

<div id="departments">
  <%= link_to "新規作成", new_department_path %>

  <ul>
    <% @departments.each do |department| %>
      <li style="padding-bottom: 12px;">
        <h3><%= department.name %></h3>
        <%= link_to "編集", edit_department_path(department) %>
      </li>
    <% end %>
  </ul>
</div>