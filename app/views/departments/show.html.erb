<h1><%= @department.name %></h1>

  <nav>
    <ol style="list-style: none; display: flex; align-items: center;">
      <li><%= link_to "部署一覧", departments_path %></li>
      <span>　>　</span>
      <li><%= link_to @department.name, department_path(@department) %></li>
    </ol>
  </nav>

  <ul>
    <% @department.users.each do |user| %>
        <p><%= user.name %></p>
    <% end %>
  </ul>

<%= link_to "一覧に戻る", departments_path %>