<h1>Users</h1>

<div id="users">
  <%= form_with url: users_path, method: :get do |form| %>
    <%= form.label :name, "名前:" %>
    <%= form.search_field :name %>
    <%= form.submit "探す" %>
  <% end %>

  <%= form_with url: users_path, method: :get do |form| %>
    <%= form.label :prefecture, "都道府県:" %>
    <%= form.select :prefecture, User.prefectures.keys %>
    <%= form.submit "探す" %>
  <% end %>


  <%= form_with url: users_path, method: :get do |form| %>
    <%= form.label :birthday_asc, "誕生日(昇順):" %>
    <%= form.checkbox :birthday_asc %>
    <%= form.label :birthday_desc, "誕生日(降順):" %>
    <%= form.checkbox :birthday_desc%>
     <%= form.submit "絞り込む" %>
  <% end %>

  <%= form_with url: users_path, method: :get do |form| %>
    <%= form.label :per_page, "表示件数:" %>
    <%= form.select :per_page, ["10","50","100"], selected: params[:per_page] || "100" %>
    <%= form.submit "絞り込む" %>
  <% end %>


  <% @users.each do |user| %>
    <li style="padding-bottom: 12px;">
      <h3><%= user.name %></h3>
      <%= link_to "詳細", user_path(user) %>
    </li>
  <% end %>
</div>

<%= paginate @users %>
