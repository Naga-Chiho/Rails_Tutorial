<% content_for(:title, "ユーザー一覧") %>
<h1>Users</h1>

<% content_for :head do %>
  <%= tag.meta name: "description", content: "ユーザー一覧のページです" %>
  <%= tag.meta name: "keywords", content: "Rails, Tutorial, Admin, Users, Departments, Skills" %>
  <%= tag.meta name: "viewport", content: "width=device-width,initial-scale=1" %>
  <%= tag.meta name: "apple-mobile-web-app-capable", content: "yes" %>
  <%= tag.meta name: "application-name", content: "App" %>
  <%= tag.meta name: "mobile-web-app-capable", content: "yes" %>
  <%= tag.meta property: "og:title", content: "ユーザー一覧 | Railsチュートリアル" %>
  <%= tag.meta property: "og:description", content: "ユーザー一覧のページです" %>
  <%= tag.meta property: "og:type", content: "article" %>
  <%= tag.meta property: "og:url", content: users_url %>
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
<% end %>

<div id="users">
  <%= form_with url: admin_users_path, method: :get do |form| %>
    <%= form.label :name, "名前:" %>
    <%= form.search_field :name, value: @param_name %>

    <%= form.label :prefecture, "都道府県:" %>
    <%= form.select :prefecture, @user_prefectures, { include_blank: "指定なし", selected: @param_prefecture  } %>

    <%= form.label :birthday, "誕生日:" %>
    <%= form.select :birthday, [["昇順", "asc"], ["降順", "desc"]], { include_blank: "指定なし", selected: @param_birthday }, selected: @param_birthday %>

    <%= form.label :per_page, "表示件数:" %>
    <%= form.select :per_page, ["10","50","100"], { include_blank: "指定なし", selected: @param_per_page }, selected: @param_per_page || "100" %>

    <%= form.submit "探す" %>
  <% end %>

  <nav>
    <ol style="list-style: none;">
      <li><%= link_to content_for(:title), users_path %></li>
    </ol>
  </nav>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "ユーザー一覧",
        "item": "users_url"
      }
    ]
  }
  </script>


  <% @users.each do |user| %>
    <li style="padding-bottom: 12px;">
      <h3><%= user.name %></h3>
      <%= link_to "詳細", user_path(user) %>
    </li>
  <% end %>
</div>

<%= paginate @users %>
