<h1><%= @user.name %></h1>

  <nav>
    <ol style="list-style: none; display: flex; align-items: center;">
      <li><%= link_to "ユーザー一覧", users_path %></li>
      <span>　>　</span>
      <li><%= link_to @user.name, user_path(@user) %></li>
    </ol>
  </nav>

<table>
  <tr>
    <th>項目</th>
    <th>内容</th>
  </tr>
  <tr>
    <td>氏名</td>
    <td><%= @user.name %></td>
  </tr>
  <tr>
    <td>フリガナ</td>
    <td><%= @user.furigana %></td>
  </tr>
  <tr>
    <td>性別</td>
    <td><%= @user.gender %></td>
  </tr>
  <tr>
    <td>部署</td>
    <td><%= @user.department.name %></td>
  </tr>
  <tr>
    <td>電話番号</td>
    <td><%= @user.phone %></td>
  </tr>
  <tr>
    <td>携帯電話番号</td>
    <td><%= @user.mobile_phone %></td>
  </tr>
  <tr>
    <td>メールアドレス</td>
    <td><%= @user.email %></td>
  </tr>
  <tr>
    <td>郵便番号</td>
    <td><%= @user.postal_code %></td>
  </tr>
  <tr>
    <td>都道府県</td>
    <td><%= @user.prefecture %></td>
  </tr>
  <tr>
    <td>市区町村</td>
    <td><%= @user.city %></td>
  </tr>
  <tr>
    <td>町名・丁目</td>
    <td><%= @user.town %></td>
  </tr>
  <tr>
    <td>番地</td>
    <td><%= @user.street %></td>
  </tr>
  <tr>
    <td>建物名・部屋番号</td>
    <td><%= @user.building %></td>
  </tr>
  <tr>
    <td>誕生日</td>
    <td><%= @user.birthday %></td>
  </tr>
    <tr>
    <td>画像</td>
    <td>
      <% if @user.image.present? %>
        <%= image_tag show_image_admin_user_path(@user), size: "200x200" %>
      <% else %>
        画像なし
      <% end %>
    </td>
  </tr>
    <tr>
    <td>スキル</td>
    <td> 
      <ul> 
        <% @user.skills.each do |skill| %>
          <li><%= skill.name %></li>
        <% end %>
      </ul>
    </td> 
  </tr>
</table>

<%= link_to "一覧に戻る", users_path %>
